---
import PageLayout from './PageLayout.astro';
import Icon from '../components/ui/Icon.astro';

interface Props {
  title: string;
  description: string;
  icon?: string;
}

const { title, description, icon = 'file-text' } = Astro.props;
---

<PageLayout title={title} description={description}>
  <div class="tramite-header">
    <div class="container">
      <div class="header-content" data-animate>
        <div class="icon-wrapper">
          <Icon name={icon} size={40} />
        </div>
        <h1>{title}</h1>
        <p class="description">{description}</p>
      </div>
    </div>
  </div>

  <div class="container tramite-container">
    <div class="tramite-content" data-animate>
      <slot />
    </div>
    
    <aside class="tramite-sidebar" data-animate>
      <div class="help-box">
        <h3>¿Necesitas ayuda?</h3>
        <p>Contacta con secretaría de la facultad para más información sobre este proceso.</p>
        <ul class="contact-list">
          <li><Icon name="clock" size={16} /> Lunes a Viernes: 08:00 - 17:00</li>
          <li><Icon name="map-pin" size={16} /> Secretaría, Campus Quito</li>
        </ul>
        <a href="/faq" class="btn btn-outline" style="width: 100%; margin-top: var(--space-4);">Ver Preguntas Frecuentes</a>
      </div>
    </aside>
  </div>
</PageLayout>

<style>
  .tramite-header {
    background: var(--color-purple-900);
    color: white;
    padding: var(--space-16) 0;
    margin-bottom: var(--space-12);
  }

  .header-content {
    max-width: 800px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .icon-wrapper {
    background: rgba(255, 255, 255, 0.1);
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    color: var(--color-orange-500);
  }

  .description {
    font-size: var(--text-lg);
    color: var(--color-purple-100);
  }

  .tramite-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    margin-bottom: var(--space-20);
  }

  @media (min-width: 1024px) {
    .tramite-container {
      grid-template-columns: 2.5fr 1fr;
    }
  }

  .tramite-content :global(h2) {
    color: var(--color-orange-500);
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
  }

  .tramite-content :global(h3) {
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .tramite-content :global(p) {
    margin-bottom: var(--space-4);
  }

  .tramite-content :global(ul) {
    list-style-type: disc;
    padding-left: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .tramite-content :global(li) {
    margin-bottom: var(--space-2);
    color: var(--text-secondary);
  }

  .help-box {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    position: sticky;
    top: 100px;
  }

  .help-box h3 {
    margin-bottom: var(--space-2);
    font-size: var(--text-lg);
  }

  .contact-list {
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .contact-list li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }
</style>
