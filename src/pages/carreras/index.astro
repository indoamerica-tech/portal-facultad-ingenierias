---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Icon from '../../components/ui/Icon.astro';
import { CARRERAS } from '../../data/site';

const title = 'Carreras';
const description =
  'Carreras de ingeniería de la Universidad Tecnológica Indoamérica en el campus Quito: Ingeniería Industrial, Tecnologías de la Información e Ingeniería Eléctrica.';
---

<PageLayout title={title} description={description}>
  <PageHero
    eyebrow="Oferta académica · Quito"
    index="01"
    title="Nuestras carreras"
    highlight="carreras"
    lead="Tres programas de ingeniería en el campus Quito, cada uno con su malla y su modalidad. Elige el problema que quieres resolver."
  />

  <section class="section">
    <div class="container">
      <ul class="lista" data-stagger="80">
        {CARRERAS.map((c, i) => (
          <li data-reveal="up">
            <a href={c.href} class="fila spotlight" style={`--accent-card:${c.color}`}>
              <span class="fila__num mono">{String(i + 1).padStart(2, '0')}</span>

              <span class="fila__icon"><Icon name={c.icon} size={24} /></span>

              <span class="fila__main">
                <h2>{c.nombre}</h2>
                <p>{c.descripcion}</p>
                <span class="fila__tags">
                  {c.destacados.map((d) => <span class="mono">{d}</span>)}
                </span>
              </span>

              <span class="fila__specs">
                <span class="spec-item">
                  <span class="spec-item__k mono">Campus</span>
                  <span class="spec-item__v">{c.campus}</span>
                </span>
                <span class="spec-item">
                  <span class="spec-item__k mono">Modalidad</span>
                  <span class="spec-item__v">{c.modalidad}</span>
                </span>
                <span class="spec-item">
                  <span class="spec-item__k mono">Duración</span>
                  <span class="spec-item__v">{c.duracion}</span>
                </span>
              </span>

              <span class="fila__cta" aria-hidden="true">
                <Icon name="arrow-right" size={17} />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</PageLayout>

<style>
  .lista { display: flex; flex-direction: column; }

  .fila {
    --accent-card: var(--accent);
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-8) var(--space-5);
    border-top: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    transition: background-color var(--transition-base);
  }
  .lista li:last-child .fila { border-bottom: 1px solid var(--border-color); }

  @media (min-width: 1024px) {
    .fila {
      grid-template-columns: auto auto minmax(0, 1.5fr) minmax(0, 1fr) auto;
      gap: var(--space-8);
    }
  }

  .fila.spotlight::before {
    background: radial-gradient(
      480px circle at var(--mx, 50%) var(--my, 50%),
      color-mix(in srgb, var(--accent-card) 11%, transparent),
      transparent 62%
    );
  }

  .fila__num {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    color: var(--text-muted);
    transition: color var(--transition-base);
  }
  .fila:hover .fila__num { color: var(--accent-card); }

  @media (max-width: 560px) {
    .fila { grid-template-columns: auto 1fr; gap: var(--space-4); }
    .fila__num { display: none; }
  }

  .fila__icon {
    display: grid;
    place-items: center;
    width: 56px; height: 56px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    color: var(--accent-card);
    background: color-mix(in srgb, var(--accent-card) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent-card) 26%, transparent);
    transition: transform 520ms var(--ease-out-back);
  }
  .fila:hover .fila__icon { transform: scale(1.08) rotate(-7deg); }

  .fila__main { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }

  .fila__main h2 {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    transition: color var(--transition-base);
  }
  .fila:hover .fila__main h2 { color: var(--accent-card); }

  .fila__main p { font-size: var(--text-sm); margin: 0; max-width: 48ch; }

  .fila__tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: var(--space-1); }
  .fila__tags span {
    padding: 0.28rem 0.55rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    font-size: 0.5625rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-muted);
  }

  .fila__specs {
    display: none;
    flex-direction: column;
    gap: var(--space-3);
  }
  @media (min-width: 1024px) {
    .fila__specs { display: flex; }
  }

  .spec-item { display: flex; flex-direction: column; gap: 2px; }
  .spec-item__k {
    font-size: 0.5625rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--text-muted);
  }
  .spec-item__v { font-size: var(--text-xs); font-weight: 600; color: var(--text-primary); }

  .fila__cta {
    display: none;
    place-items: center;
    width: 44px; height: 44px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    transition: all 420ms var(--ease-out-expo);
  }
  @media (min-width: 1024px) {
    .fila__cta { display: grid; }
  }
  .fila:hover .fila__cta {
    background: var(--accent-card);
    border-color: var(--accent-card);
    color: #fff;
    transform: translateX(5px);
  }
</style>
