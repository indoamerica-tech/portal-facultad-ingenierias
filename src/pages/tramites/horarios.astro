---
import TramiteLayout from '../../layouts/TramiteLayout.astro';
import Icon from '../../components/ui/Icon.astro';
import { CARRERAS } from '../../data/site';

/* ⚠ PENDIENTE: la coordinación aún no ha entregado los horarios ni el enlace
   al documento oficial. Esta página deja la estructura lista; cuando lleguen
   los datos, basta con rellenar `horarios` y quitar el aviso. */
const horarios: { carrera: string; niveles: string; jornada: string; url?: string }[] = [];
---

<TramiteLayout
  title="Horarios"
  description="Consulta el horario de clases por carrera, nivel y paralelo."
  icon="calendar-days"
>
  <div class="content-block">
    <h3>Cómo consultar tu horario</h3>
    <ul>
      <li>Ubica tu carrera en la lista y descarga el horario del periodo vigente.</li>
      <li>Verifica el <strong>nivel</strong> y el <strong>paralelo</strong> en los que quedaste matriculado.</li>
      <li>Si detectas un cruce de materias, comunícalo a la coordinación de tu carrera antes del cierre de matrículas.</li>
    </ul>

    {horarios.length === 0 ? (
      <div class="pendiente" role="status">
        <span class="pendiente__icon"><Icon name="clock" size={20} /></span>
        <div>
          <h4>Horarios del periodo aún no publicados</h4>
          <p>
            En cuanto la coordinación publique los horarios de este periodo, aparecerán
            aquí para su descarga. Mientras tanto, consulta directamente con la
            coordinación de tu carrera.
          </p>
        </div>
      </div>
    ) : (
      <div class="tabla">
        {horarios.map((h) => (
          <div class="fila">
            <strong>{h.carrera}</strong>
            <span class="mono">{h.niveles}</span>
            <span class="mono">{h.jornada}</span>
            {h.url && (
              <a href={h.url} class="link-arrow">
                Descargar <Icon name="download" size={15} />
              </a>
            )}
          </div>
        ))}
      </div>
    )}

    <h3 class="mt">Carreras del campus Quito</h3>
    <div class="carreras">
      {CARRERAS.map((c) => (
        <a href={c.href} class="carrera spotlight" style={`--accent-card:${c.color}`}>
          <span class="carrera__icon"><Icon name={c.icon} size={20} /></span>
          <span class="carrera__body">
            <strong>{c.nombre}</strong>
            <span class="mono">{c.modalidad}</span>
          </span>
          <Icon name="arrow-up-right" size={15} class="carrera__arrow" />
        </a>
      ))}
    </div>
  </div>
</TramiteLayout>

<style>
  .content-block { margin-top: var(--space-8); }
  .content-block h3 { margin-bottom: var(--space-4); }
  .content-block h3.mt { margin-top: var(--space-12); }
  .content-block ul {
    list-style-type: disc;
    padding-left: var(--space-6);
    margin-bottom: var(--space-8);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }
  .content-block li { margin-bottom: var(--space-2); }

  /* Aviso de contenido pendiente: honesto, no un placeholder disfrazado */
  .pendiente {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    border: 1px dashed color-mix(in srgb, var(--accent) 40%, transparent);
    background: var(--accent-soft);
  }
  .pendiente__icon {
    display: grid;
    place-items: center;
    width: 40px; height: 40px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    background: var(--bg-secondary);
    color: var(--accent-text);
  }
  .pendiente h4 {
    font-size: var(--text-base);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .pendiente p {
    font-size: var(--text-sm);
    margin: 0;
    max-width: 60ch;
  }

  .tabla { display: flex; flex-direction: column; gap: var(--space-2); }
  .fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding: var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
  }

  .carreras { display: flex; flex-direction: column; gap: var(--space-2); }
  .carrera {
    --accent-card: var(--accent);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
    transition: border-color var(--transition-base), transform var(--transition-base);
  }
  .carrera:hover {
    border-color: color-mix(in srgb, var(--accent-card) 45%, transparent);
    transform: translateX(4px);
  }
  .carrera__icon {
    display: grid;
    place-items: center;
    width: 42px; height: 42px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    color: var(--accent-card);
    background: color-mix(in srgb, var(--accent-card) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent-card) 26%, transparent);
  }
  .carrera__body { display: flex; flex-direction: column; gap: 2px; }
  .carrera__body strong { font-size: var(--text-sm); color: var(--text-primary); }
  .carrera__body .mono {
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-muted);
  }
  .carrera__arrow {
    margin-left: auto;
    color: var(--text-muted);
    transition: color var(--transition-base);
  }
  .carrera:hover .carrera__arrow { color: var(--accent-card); }
</style>
