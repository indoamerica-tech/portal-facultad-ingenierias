---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import AssistantWidget from '../components/interactive/AssistantWidget';

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Oculta el asistente flotante (p.ej. en la 404) */
  assistant?: boolean;
}

const { title, description, image, assistant = true } = Astro.props;
---

<BaseLayout title={title} description={description} image={image}>
  <Header />

  <main id="main">
    <slot />
  </main>

  <Footer />

  {assistant && <AssistantWidget client:idle />}
</BaseLayout>

<style>
  main { min-height: 60vh; }
</style>
