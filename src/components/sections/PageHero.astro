---
import Icon from '../ui/Icon.astro';

interface Props {
  eyebrow: string;
  index?: string;
  title: string;
  /** Palabra del título que se pinta con el acento. Debe existir en `title`. */
  highlight?: string;
  lead?: string;
  breadcrumb?: { label: string; href: string }[];
}

const { eyebrow, index, title, highlight, lead, breadcrumb = [] } = Astro.props;

/* Parte el título alrededor de la palabra destacada para poder envolverla
   en <em> sin usar innerHTML. Si no coincide, se renderiza tal cual. */
const at = highlight ? title.indexOf(highlight) : -1;
const before = at >= 0 ? title.slice(0, at) : title;
const after = at >= 0 ? title.slice(at + highlight!.length) : '';
---

<section class="page-hero">
  <div class="page-hero__bg" aria-hidden="true">
    <div class="aurora">
      <span class="aurora__blob aurora__blob--a"></span>
      <span class="aurora__blob aurora__blob--b"></span>
    </div>
    <div class="blueprint-grid"></div>
  </div>

  <div class="container page-hero__inner">
    {breadcrumb.length > 0 && (
      <nav class="crumbs" aria-label="Ruta de navegación" data-reveal="fade">
        <a href="/">Inicio</a>
        {breadcrumb.map((b) => (
          <>
            <Icon name="chevron-right" size={12} />
            <a href={b.href}>{b.label}</a>
          </>
        ))}
      </nav>
    )}

    <span class="eyebrow" data-reveal="fade" data-reveal-delay="1">
      {index && <span class="section-index">{index}</span>}
      {eyebrow}
    </span>

    <h1 class="page-hero__title" data-reveal="mask" data-reveal-delay="2">
      <span>
        {before}{at >= 0 && <em>{highlight}</em>}{after}
      </span>
    </h1>

    {lead && (
      <p class="lead" data-reveal="up" data-reveal-delay="3">{lead}</p>
    )}

    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(2.5rem, 5vw, 4.5rem);
    border-bottom: 1px solid var(--border-color);
  }

  .page-hero__bg { position: absolute; inset: 0; z-index: -1; }

  .page-hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .crumbs a { transition: color var(--transition-fast); }
  .crumbs a:hover { color: var(--accent-text); }
  .crumbs :global(svg) { opacity: 0.5; }

  .page-hero__title {
    font-size: var(--text-6xl);
    font-weight: 800;
    letter-spacing: var(--tracking-tighter);
    line-height: 1;
    max-width: 18ch;
  }

  .page-hero__title em {
    font-style: italic;
    color: var(--accent);
  }

  .page-hero .lead { max-width: 58ch; }
</style>
