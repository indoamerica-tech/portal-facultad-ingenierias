---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import TramitesSearch from '../../components/interactive/TramitesSearch';

const title = 'Trámites y Procesos';
const description =
  'Encuentra toda la información sobre los procesos académicos y administrativos de la Facultad de Ingenierías.';
---

<PageLayout title={title} description={description}>
  <PageHero
    eyebrow="Servicios digitales"
    index="02"
    title="Trámites y procesos"
    highlight="procesos"
    lead={description}
  />

  <section class="section">
    <div class="container" data-reveal="up">
      <TramitesSearch client:load />
    </div>
  </section>
</PageLayout>
